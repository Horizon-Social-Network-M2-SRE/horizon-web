{
  "name": "horizon-web",
  "version": "0.1.0",
  "private": true,
  "description": "Horizon Social Network web app (Next.js, mobile-first PWA)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:generate": "openapi-typescript openapi/openapi.json -o src/lib/api/schema.d.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
