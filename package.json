{
  "name": "horizon-web",
  "version": "0.1.0",
  "private": true,
  "description": "Horizon Social Network web app (Next.js, mobile-first PWA)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:generate": "openapi-typescript openapi/openapi.json -o src/lib/api/schema.d.ts",
    "typecheck:api": "tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --skipLibCheck --types node src/lib/api/client.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}